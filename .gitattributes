# autocrlf on Windows would rewrite LF to CRLF in the index, breaking the
# formatter's endOfLine: "lf" (vite.config.ts) and the `.vite-hooks/*` shims.
* text=auto eol=lf

# Hooks run under sh, never cmd.exe: LF only, and keep +x.
.vite-hooks/** text eol=lf

# Batch files need CRLF for cmd.exe.
*.cmd text eol=crlf
*.bat text eol=crlf

# Never line-ending converted or diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.wasm binary
*.mp3 binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Generated files: keep them out of diffs and language stats.
pnpm-lock.yaml linguist-generated=true -diff
**/routeTree.gen.ts linguist-generated=true -diff