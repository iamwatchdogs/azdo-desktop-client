#!/usr/bin/env sh
# Vite+ hook shim: the merge guard.
#
# Git runs this only from the `git merge` builtin, on a merge that completes on
# its own. The path that matters most is the conflicting one: you resolve, then
# finish with `git commit`, which runs pre-commit instead — and pre-commit runs
# these same policy checks via `vp staged`. Both merge paths are covered, by
# different hooks.
#
# Merges run the FULL suite, not pre-commit's changed-scoped selection: a merge
# can pull in commits you never touched, so `tests:all` is the right question.
#
# Git already refuses a commit with unmerged files. What this adds is a conflict
# "resolved" by `git add` with the markers left in: git accepts that, only this
# check rejects it.
cd "$(git rev-parse --show-toplevel)" || exit 1

node scripts/hooks/policies.ts || exit 1

exec vp run tests:all