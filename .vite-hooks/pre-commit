#!/usr/bin/env sh
# Vite+ hook shim: staged-file checks + affected tests on commit.
#
# The commit-time policy is declared in vite.config.ts:
#   staged.*        -> lint-staged checks (vp check --fix, policies)
#   run.tasks tests:changed -> only the specs this commit actually touches
#
# Tests are scoped, not skipped: `GITHOOK_BASE` is HEAD, so `vitest --changed`
# and Playwright's `--only-changed` select the specs affected by what you are
# committing. A commit that breaks an unrelated spec stays green, which is the
# point — the full matrix runs in the push gate.
#
# `cd` to the repository root is deliberate: `vp staged` reads the `staged`
# block from the root vite.config.ts and fails when invoked from a workspace
# package (voidzero-dev/vite-plus#2177). Do not "simplify" it away.
cd "$(git rev-parse --show-toplevel)" || exit 1

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")
case "$branch" in
  main | master)
    if [ "${ALLOW_MAIN:-}" != "1" ]; then
      echo "pre-commit: refusing to commit directly on '$branch'." >&2
      echo "  Create a branch first:  git switch -c <branch-name>" >&2
      echo "  Override once with:    ALLOW_MAIN=1 git commit ..." >&2
      exit 1
    fi
    echo "pre-commit: ALLOW_MAIN=1 set - committing on '$branch'" >&2
    ;;
esac

vp staged || exit 1

GITHOOK_BASE=HEAD
export GITHOOK_BASE
exec vp run tests:changed