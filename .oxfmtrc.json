{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",

  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "jsxSingleQuote": false,
  "objectWrap": "preserve",
  "printWidth": 100,
  "quoteProps": "as-needed",
  "semi": true,
  "singleAttributePerLine": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,

  "ignorePatterns": [
    "node_modules",
    "dist",
    "dist-electron",
    "release",
    "pnpm-lock.yaml",
    "*.tsbuildinfo",
    "**/routeTree.gen.ts"
  ],

  "sortPackageJson": { "sortScripts": true },

  "sortImports": {
    "groups": [
      "side_effect",
      "side_effect_style",
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ]
  },

  "sortTailwindcss": { "preserveDuplicates": true }
}
