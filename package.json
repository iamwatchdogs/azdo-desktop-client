{
  "name": "@ado/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run --filter @ado/desktop build",
    "check": "vp check",
    "check:complexity": "vp lint -c .oxlintrc.complexity.json",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist apps/*/dist-electron packages/*/dist .vite-plus apps/*/.vite-plus packages/*/.vite-plus",
    "dev": "vp run --filter @ado/desktop dev",
    "dist": "vp run --filter @ado/desktop dist",
    "prepare": "vp config --no-agent",
    "start": "vp run --filter @ado/desktop start",
    "test": "vp run -r test",
    "test:e2e": "vp run --filter @ado/desktop test:e2e",
    "typecheck": "vp run -r typecheck"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@shadcn/lint": "catalog:",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-plugin-complexity": "catalog:",
    "ts-morph": "catalog:",
    "tsc-rs": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24.13.1",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.11.2"
}
