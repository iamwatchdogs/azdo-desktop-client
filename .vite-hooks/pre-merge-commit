#!/usr/bin/env sh
# Vite+ hook shim: guard the merge commit.
#
# Git invokes this only from the `git merge` builtin, and only when the merge
# completes on its own. The path that matters most is different: when a merge
# conflicts, you resolve it and finish with `git commit`, which runs
# pre-commit instead — and pre-commit runs this same script via `vp staged`.
# So both merge paths are covered, just by different hooks.
#
# Git already refuses a commit with unmerged files. The case this adds is a
# conflict "resolved" by `git add` without deleting the markers: git accepts
# that, and only this check catches it.
cd "$(git rev-parse --show-toplevel)" || exit 1
exec node scripts/hooks/policies.ts